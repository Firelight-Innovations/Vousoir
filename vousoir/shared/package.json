{
  "name": "@vousoir/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared runtime utilities for the Vousoir layer (NOT types — those live in @vousoir/typings). Home of v6rInit() and other cross-package helpers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vousoir/typings": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "24.x"
  }
}
